+
+type CharacterSource =
+  | "saved"
+  | "ai";
+
+type VideoCharacterInput = {
+  id: string;
+  name: string;
+  role: string;
+  visualDescription: string;
+  imagePrompt?: string;
+  imageUrl?: string;
+  imageKey?: string;
+  source?: CharacterSource;
+  savedCharacterId?: string;
+};
+
+const resolveCharacterReferences = async (
+  characters: VideoCharacterInput[],
+): Promise<VideoCharacterInput[]> => {
+  if (characters.length === 0) {
+    return [];
+  }
+
+  const resolved: VideoCharacterInput[] = [];
+
+  for (const character of characters) {
+    const source =
+      character.source ??
+      (character.imageUrl
+        ? "saved"
+        : "ai");
+
+    /*
+     * Saved characters remain image-first and are reused exactly as selected.
+     */
+    if (source === "saved") {
+      if (!character.imageUrl?.trim()) {
+        throw new Error(
+          `Saved character "${character.name}" is missing its image reference.`,
+        );
+      }
+
+      console.log(
+        `[VideoService] Reusing saved character: ${character.name}`,
+      );
+
+      resolved.push({
+        ...character,
+        imagePrompt: undefined,
+        source: "saved",
+      });
+
+      continue;
+    }
+
+    /*
+     * T2V AI characters do NOT get a separate character-library image at this
+     * stage. A separate image request can be rejected by the image provider's
+     * safety system and is unnecessary because Wan I2V needs a scene frame,
+     * not a character-sheet image.
+     *
+     * The scene keyframe is generated later, from the actual scene plan.
+     */
+    console.log(
+      `[VideoService] T2V AI character reference generation skipped: ${character.name}`,
+    );
+
+    resolved.push({
+      ...character,
+      imageUrl: undefined,
+      source: "ai",
+      savedCharacterId: undefined,
+    });
+  }
+
+  return resolved;
+};

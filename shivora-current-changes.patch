+   * /uploads/videos/<file>.mp4
+   * This is relative to the backend project, not the filesystem root.
+   */
+  if (
+    trimmed.startsWith("/uploads/")
+  ) {
+    return path.resolve(
+      process.cwd(),
+      trimmed.slice(1),
+    );
+  }
+
+  if (
+    path.isAbsolute(trimmed)
+  ) {
+    return trimmed;
+  }
+
+  return path.resolve(
+    process.cwd(),
+    trimmed.replace(/^\/+/, ""),
+  );
+};

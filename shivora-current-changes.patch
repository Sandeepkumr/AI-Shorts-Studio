+  ).current;
+
+  useEffect(() => {
+    const loop =
+      Animated.loop(
+        Animated.sequence([
+          Animated.delay(delay),
+          Animated.timing(opacity, {
+            toValue: 1,
+            duration: 450,
+            easing: Easing.inOut(Easing.ease),
+            useNativeDriver: true,
+          }),
+          Animated.timing(opacity, {
+            toValue: 0.35,
+            duration: 450,
+            easing: Easing.inOut(Easing.ease),
+            useNativeDriver: true,
+          }),
+          Animated.delay(
+            Math.max(0, 540 - delay),
+          ),
+        ]),
+      );
+
+    loop.start();
+
+    return () => {
+      loop.stop();
+    };
+  }, [delay, opacity]);
+
+  return (
+    <Animated.View

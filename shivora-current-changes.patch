+const runVideoGenerationPreflight = (
+  options: VideoGenerationOptions,
+  clipScenePlans: Array<VideoScenePlan | undefined>,
+  clipCount: number,
+  aspectRatio: string,
+): void => {
+  console.log("[VideoService] ==================================================");
+  console.log("[VideoService] PRE-FLIGHT ONLY MODE ENABLED");
+  console.log("[VideoService] No image-generation or video-generation provider will be called.");
+  console.log("[VideoService] ==================================================");
+
+  let previousSceneCharacters: VideoCharacterInput[] = [];
+  let previousFrameAvailable = false;
+
+  for (let index = 0; index < clipCount; index += 1) {
+    const scenePlan = clipScenePlans[index];
+    const basePrompt = scenePlan
+      ? buildScenePromptFromPlan(scenePlan)
+      : (options.scenePrompts?.[index] || options.prompt || "Create a cinematic short video scene.");
+
+    const sceneCharacters = getCharactersForScene(
+      (options.characters ?? []) as VideoCharacterInput[],
+      basePrompt,
+      previousSceneCharacters,
+      scenePlan,
+    );
+
+    // Every T2V beat must have a fresh authoritative scene keyframe.
+    const needsSceneKeyframe = true;
+
+    const hasAuthoritativeSceneKeyframe = needsSceneKeyframe;
+    const referenceSource = hasAuthoritativeSceneKeyframe
+      ? "scene-keyframe"
+      : previousFrameAvailable
+        ? "previous-frame"
+        : sceneCharacters[0]?.imageUrl?.trim()
+          ? "character-reference"
+          : "MISSING";
+
+    const prompt = buildClipPrompt(
+      options,
+      basePrompt,
+      index,
+      previousSceneCharacters,
+      index === clipCount - 1,
+      scenePlan,
+      previousFrameAvailable,
+      "",
+      hasAuthoritativeSceneKeyframe,
+    );
+
+    const keyframePrompt = buildSceneKeyframePrompt(
+      basePrompt,
+      scenePlan,
+      sceneCharacters,
+      index,
+      previousFrameAvailable,
+    );
+
+    console.log(`[VideoService][Preflight] Clip ${index + 1}/${clipCount}`);
+    console.log(`[VideoService][Preflight] start authority: ${
+      hasAuthoritativeSceneKeyframe
+        ? "scene-keyframe (authoritative)"
+        : previousFrameAvailable
+          ? "previous-frame (authoritative)"
+          : "manifest/character reference"
+    }`);
+    console.log(`[VideoService][Preflight] reference source: ${referenceSource}`);
+    console.log(`[VideoService][Preflight] previous frame role: ${
+      previousFrameAvailable
+        ? "continuity context only"
+        : "none"
+    }`);
+    console.log(`[VideoService][Preflight] visible characters: ${
+      sceneCharacters.map((character) => character.name).join(", ") || "none"
+    }`);
+    console.log(`[VideoService][Preflight] scene plan:`, {
+      title: scenePlan?.title,
+      startState: scenePlan?.startState,
+      actions: scenePlan?.actions,
+      endState: scenePlan?.endState,
+    });
+    console.log(`[VideoService][Preflight] Wan prompt:\n${prompt}`);
+    console.log(`[VideoService][Preflight] T2V image keyframe prompt:\n${keyframePrompt}`);
+
+    if (referenceSource === "MISSING") {
+      throw new Error(
+        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} has no valid reference source.`,
+      );
+    }
+
+    if (hasAuthoritativeSceneKeyframe && !prompt.includes("scene-keyframe reference is authoritative")) {
+      throw new Error(
+        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} prompt does not contain the required scene-keyframe authority instruction.`,
+      );
+    }
+
+    if (
+      hasAuthoritativeSceneKeyframe &&
+      /Direct continuation of the previous clip\. Start from its final frame/i.test(prompt)
+    ) {
+      throw new Error(
+        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} still contains the old previous-frame authority instruction.`,
+      );
+    }
+
+    if (
+      hasAuthoritativeSceneKeyframe &&
+      /previous-frame reference is authoritative for visual continuity at the start/i.test(prompt)
+    ) {
+      throw new Error(
+        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} still treats the previous frame as authoritative.`,
+      );
+    }
+
+    const unsafeImagePromptTerms = [
+      ...sceneCharacters
+        .map((character) => character.name.trim())
+        .filter(Boolean),
+      "spider-man",
+      "spiderman",
+      "स्पाइडर-मैन",
+      "spider-themed",
+      "spider theme",
+      "spider based",
+      "spider inspired",
+      "web patterns",
+      "स्पाइडर-थीम",
+      "स्पाइडर थीम",
+      "स्पाइडर-आधारित",
+      "स्पाइडर आधारित",
+      "स्पाइडर-प्रेरित",
+      "स्पाइडर प्रेरित",
+      "मकड़ी",
+      "superman",
+      "सुपरमैन",
+      "batman",
+      "बैटमैन",
+      "iron-man",
+      "iron man",
+      "आयरन-मैन",
+    ];
+
+    const unsafeImagePromptMatches = unsafeImagePromptTerms.filter((term) =>
+      new RegExp(escapeRegExp(term), "iu").test(keyframePrompt),
+    );
+
+    const residualSpiderFamilyMatch = keyframePrompt.match(
+      /(?:spider|स्पाइडर|मकड़ी)(?:[- ]?(?:man|मैन|themed|theme|थीम|आधारित|based|inspired|प्रेरित))?/iu,
+    );
+
+    if (residualSpiderFamilyMatch) {
+      unsafeImagePromptMatches.push(
+        residualSpiderFamilyMatch[0],
+      );
+    }
+
+    if (unsafeImagePromptMatches.length > 0) {
+      throw new Error(
+        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} T2V image keyframe prompt still contains unsafe/branded terms: ${unsafeImagePromptMatches.join(", ")}.`,
+      );
+    }
+
+    previousSceneCharacters = sceneCharacters;
+    previousFrameAvailable = true;
+  }
+
+  console.log("[VideoService] PRE-FLIGHT PASSED: all clip reference-authority checks passed.");
+  console.log(`[VideoService] PRE-FLIGHT target: ${options.durationSeconds ?? "default"}s; aspect ratio: ${aspectRatio}.`);
+  console.log("[VideoService] No paid generation was performed.");
+};

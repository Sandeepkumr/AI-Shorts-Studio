const CLIP_DURATION_SECONDS = 5;

const VIDEO_FRAME_UPLOAD_DIR =
  path.resolve(
    "uploads",
    "video-frames",
  );

const execFileAsync =
  promisify(execFile);

const resolveLocalUploadPath = (
  value: string,
): string => {
  const trimmed =
    value.trim();

  if (!trimmed) {
    throw new Error(
      "Video path is required.",
    );
  }

  /*
   * Accept backend/API URLs that point at our local /uploads tree.
   * Examples:
   *   http://192.168.31.189:4000/uploads/characters/vamika.png
   *   https://example.ngrok-free.dev/uploads/characters/vamika.png
   *
   * Character images are stored locally under the backend uploads directory,
   * so ffmpeg must receive the filesystem path rather than the HTTP URL.
   */
  if (
    trimmed.startsWith("http://") ||
    trimmed.startsWith("https://")
  ) {
    try {
      const parsed = new URL(trimmed);

      if (
        parsed.pathname.startsWith(
          "/uploads/",
        )
      ) {
        return path.resolve(
          process.cwd(),
          parsed.pathname.slice(1),
        );
      }
    } catch {
      // Fall through to normal path handling below.
    }

    throw new Error(
      `Cannot resolve remote URL as a local upload path: ${trimmed}`,
    );
  }

  /*
   * normalizeVideoClip() returns an API-style path such as:
   * /uploads/videos/<file>.mp4
   * This is relative to the backend project, not the filesystem root.
   */
  if (
    trimmed.startsWith("/uploads/")
  ) {
    return path.resolve(
      process.cwd(),
      trimmed.slice(1),
    );
  }

  if (
    path.isAbsolute(trimmed)
  ) {
    return trimmed;
  }

  return path.resolve(
    process.cwd(),
    trimmed.replace(/^\/+/, ""),
  );
};

const extractLastFrameAsReference =
  async (
    videoPath: string,
    clipNumber: number,
  ): Promise<string> => {
    await mkdir(
      VIDEO_FRAME_UPLOAD_DIR,
      {
        recursive: true,
      },
    );

    const frameName =
      `${randomUUID()}-clip-${clipNumber}.jpg`;

    const framePath =
      path.join(
        VIDEO_FRAME_UPLOAD_DIR,
        frameName,
      );

    await execFileAsync(
      "ffmpeg",
      [
        "-y",
        "-sseof",
        "-0.08",
        "-i",
        videoPath,
        "-frames:v",
        "1",
        "-q:v",
        "2",
        framePath,
      ],
      {
        maxBuffer:
          10 * 1024 * 1024,
      },
    );

    return `/uploads/video-frames/${frameName}`;
  };


const hasNamedCharacterAppearance = (
  appearance: string,
  characters: VideoCharacterInput[],
): boolean => {
  const text =
    appearance.trim();

  if (!text) {
    return false;
  }

  return characters.some(
    (character) => {
      const name =
        character.name.trim();

      if (!name) {
        return false;
      }

      const pattern =
        new RegExp(
          `\\b${escapeRegExp(name)}\\s*:`,
          "i",
        );

      return pattern.test(text);
    },
  );
};

const getCharactersForScene = (
  characters: VideoCharacterInput[],
  scenePrompt: string,
  previousSceneCharacters: VideoCharacterInput[] = [],
  scenePlan?: VideoScenePlan,
): VideoCharacterInput[] => {
  /*
   * Structured scene plans are authoritative.
   * Only the explicitly visible character IDs are selected.
   */
  if (
    scenePlan?.visibleCharacterIds &&
    scenePlan.visibleCharacterIds.length > 0
  ) {
    const requestedIds =
      new Set(
        scenePlan.visibleCharacterIds,
      );

    const selected =
      characters.filter(
        (character) =>
          requestedIds.has(
            character.id,
          ) ||
          (
            character.savedCharacterId &&
            requestedIds.has(
              character.savedCharacterId,
            )
          ),
      );

    if (selected.length > 0) {
      return selected;
    }
  }

  /*
   * Backward-compatible fallback for older requests that only contain
   * plain scenePrompts.
   */
  const normalized =
    scenePrompt.toLowerCase();

  const currentSceneCharacters =
    characters.filter(
      (character) => {
        const name =
          character.name
            .trim()
            .toLowerCase();

        return (
          name.length > 0 &&
          normalized.includes(name)
        );
      },
    );

  /*
   * Only legacy requests use previous-scene carry-over. When a structured
   * scene plan exists, its visibleCharacterIds list is the source of truth.
   */
  const combined = [
    ...previousSceneCharacters,
    ...currentSceneCharacters,
  ];

  const unique =
    new Map<
      string,
      VideoCharacterInput
    >();

  for (
    const character of combined
  ) {
    unique.set(
      character.id ||
        character.name,
      character,
    );
  }

  if (unique.size > 0) {
    return Array.from(
      unique.values(),
    );
  }

  const mainCharacters =
    characters.filter(
      (character) =>
        character.role
          .toLowerCase()
          .includes(
            "main character",
          ),
    );

  return mainCharacters.length > 0
    ? mainCharacters
    : characters.slice(0, 1);
};


export type VideoGenerationProgress = {
  status?:
    | "queued"
    | "processing";

  stage?:
    | "preparing"
    | "clips"
    | "joining"
    | "audio"
    | "finalizing";

  progress?: number;

  currentClip?: number;

  totalClips?: number;
};

export type VideoProgressCallback = (
  progress: VideoGenerationProgress,
) => void;

const getTargetDuration = (
  duration?: number,
): 15 | 30 | 60 => {
  if (
    duration === 15 ||
    duration === 30 ||
    duration === 60
  ) {
    return duration;
  }

  return 30;
};

const buildSpeechScript = (
  narration: string,
): string => {
  return narration.trim();
};

const mapVoiceToVoiceServiceVoice = (
  voice?: VideoVoice,
): string | null => {
  switch (voice) {
    case "none":
      return null;

    case "male":
      return "male";

    case "female":
      return "female";

    case "auto":
    default:
      return "female";
  }
};

const buildStyleText = (
  style?: VideoGenerationOptions["style"],
): string => {
  switch (style) {
    case "3d":
      return "3D animated movie style";

    case "cinematic":
      return "cinematic film style";

    case "realistic":
      return "realistic visual style";

    case "anime":
      return "anime visual style";

    case "cartoon":
      return "cartoon animation style";

    default:
      return "cinematic 3D animated style";
  }
};

const buildCameraText = (
  camera?: VideoGenerationOptions["camera"],
): string => {
  switch (camera) {
    case "cinematic":
      return "cinematic camera movement";

    case "close-up":
      return "close-up camera framing";

    case "wide":
      return "wide establishing camera framing";

    case "dynamic":
      return "dynamic camera movement";

    case "auto":
    default:
      return "natural cinematic camera movement";
  }
};

const buildCharacterContext = (
  characters?: VideoGenerationOptions["characters"],
): string => {
  if (
    !characters ||
    characters.length === 0
  ) {
    return "";
  }

  return characters
    .map((character) => {
      const isSaved =
        "source" in character &&
        character.source === "saved";

      /*
       * Saved characters are image-first. Their selected reference image is
       * the canonical identity. Never inject a stale/generated imagePrompt
       * or appearance description that can contradict that image.
       *
       * AI-generated characters still use their textual appearance guidance.
       */
      const preciseIdentity = isSaved
        ? ""
        : (
            "imagePrompt" in character &&
            typeof character.imagePrompt === "string" &&
            character.imagePrompt.trim()
          )
            ? character.imagePrompt.trim()
            : character.visualDescription.trim();

      return [
        `${character.name} (${character.role}):`,
        "The supplied reference image is the authoritative visual identity for this character.",
        isSaved
          ? "This is a saved character. Treat the supplied saved reference image as the sole visual identity source; do not infer or apply any alternate textual appearance description."
          : "",
        preciseIdentity
          ? `Reference appearance guidance: ${preciseIdentity}`
          : "",
        "Do not redesign, replace, age, de-age, recolor, or change the character's face, hair, clothing, species, proportions, or identity.",
      ]
        .filter(Boolean)
        .join("\n");
    })
    .join("\n");
};

const escapeRegExp = (
  value: string,
): string =>
  value.replace(
    /[.*+?^${}()|[\]\\]/g,
    "\\$&",
  );

const extractCharacterNamesFromPrompt = (
  prompt: string,
): string[] => {
  const names = new Set<string>();

  const appearanceMatch =
    prompt.match(
      /Character appearance requirements:\s*([\s\S]*?)(?=\n\n|$)/i,
    );

  const appearanceBlock =
    appearanceMatch?.[1] ?? "";

  for (
    const match of appearanceBlock.matchAll(
      /(?:^|\s)([A-Za-z][A-Za-z0-9 _'-]{0,40}):\s*/g,
    )
  ) {
    const name =
      match[1]?.trim();

    if (name) {
      names.add(name);
    }
  }

  return Array.from(names);
};

const replaceCharacterNames = (
  prompt: string,
  characters?: VideoGenerationOptions["characters"],
): string => {
  if (
    !characters ||
    characters.length === 0
  ) {
    return prompt;
  }

  const detectedNames =
    extractCharacterNamesFromPrompt(
      prompt,
    );

  if (
    detectedNames.length === 0
  ) {
    return prompt;
  }

  let resolvedPrompt =
    prompt;

  for (
    const character of characters
  ) {
    const targetName =
      character.name.trim();

    if (!targetName) {
      continue;
    }

    const oldNames =
      detectedNames.filter(
        (name) =>
          name.toLowerCase() !==
          targetName.toLowerCase(),
      );

    for (
      const oldName of oldNames
    ) {
      const pattern =
        new RegExp(
          `\\b${escapeRegExp(oldName)}\\b`,
          "gi",
        );

      resolvedPrompt =
        resolvedPrompt.replace(
          pattern,
          targetName,
        );
    }
  }

  return resolvedPrompt;
};

const replaceCharacterAppearanceNames = (
  appearance: string,
  characters?: VideoGenerationOptions["characters"],
): string =>
  replaceCharacterNames(
    appearance,
    characters,
  );

// Scene keyframes use the shared image service.
// The shared service is configured with the current primary image provider.
const sceneImageProvider = imageService;

const getCharacterIdentityKey = (
  character: VideoCharacterInput,
): string =>
  character.savedCharacterId?.trim() ||
  character.id.trim() ||
  character.name.trim().toLowerCase();

const hasNewVisibleCharacter = (
  currentCharacters: VideoCharacterInput[],
  previousCharacters: VideoCharacterInput[],
): boolean => {
  if (previousCharacters.length === 0) {
    return currentCharacters.length > 0;
  }

  const previousKeys = new Set(
    previousCharacters.map(
      getCharacterIdentityKey,
    ),
  );

  return currentCharacters.some(
    (character) =>
      !previousKeys.has(
        getCharacterIdentityKey(
          character,
        ),
      ),
  );
};

const getT2VImageSafeRoleDescription = (
  character: VideoCharacterInput,
): string => {
  const role = `${character.role} ${character.visualDescription}`.toLowerCase();

  if (
    /spider|superhero|hero|masked|mask|स्पाइडर|सुपरहीरो|मास्क/iu.test(
      `${character.name} ${character.role} ${character.visualDescription} ${character.imagePrompt ?? ""}`,
    )
  ) {
    return "the adult male customer wearing a simple red-and-blue geometric outfit with a full-face red-and-blue geometric mask";
  }

  if (
    /shopkeeper|cashier|owner|burger shop|restaurant|दुकानदार|कैशियर/iu.test(
      role,
    )
  ) {
    return "the burger shop cashier";
  }

  if (
    /customer|client|ग्राहक/iu.test(
      role,
    )
  ) {
    return "the customer";
  }

  return `the ${character.role.trim() || "story character"}`;
};

const sanitizeT2VImageGenerationText = (
  text: string,
  characters: VideoCharacterInput[],
): string => {
  let result = text;

  for (const character of characters) {
    const name = character.name.trim();

    if (!name) {
      continue;
    }

    result = result.replace(
      new RegExp(
        escapeRegExp(name),
        "giu",
      ),
      getT2VImageSafeRoleDescription(character),
    );
  }

  return result
    // English and Hindi franchise/name variants.
    .replace(/स्पाइडर[-‐‑–— ]?मैन/giu, "the masked red-and-blue superhero customer")
    .replace(/Spider[- ]?Man/giu, "the masked red-and-blue superhero customer")
    // Spider-theme variants must never reach the image provider.
    .replace(/spider[- ]?themed/giu, "simple geometric-style")
    .replace(/spider[- ]?theme/giu, "simple geometric-style")
    .replace(/स्पाइडर[-‐‑–— ]?थीम(?:वाला|वाली|वाले)?/giu, "सरल ज्यामितीय पोशाक")
    .replace(/स्पाइडर[-‐‑–— ]?थीम/giu, "सरल ज्यामितीय पोशाक")
    .replace(/स्पाइडर[-‐‑–— ]?आधारित/giu, "सरल ज्यामितीय पोशाक वाला")
    .replace(/spider[- ]?based/giu, "geometric-costume")
    .replace(/spider[- ]?inspired/giu, "original geometric-costume")
    .replace(/स्पाइडर[-‐‑–— ]?प्रेरित/giu, "मौलिक ज्यामितीय पोशाक वाला")
    .replace(/web patterns?/giu, "simple geometric suit patterns")
    .replace(/web[- ]?patterned/giu, "simple geometric patterned")
    .replace(/webbed?/giu, "geometric")
    .replace(/मकड़ी[-‐‑–— ]?(?:थीम|आधारित|जाल|पैटर्न)/giu, "ज्यामितीय")
    .replace(/मकड़ी/giu, "ज्यामितीय")
    .replace(/सुपरमैन/giu, "an adult male customer")
    .replace(/Superman/giu, "an adult male customer")
    .replace(/बैटमैन/giu, "an adult male customer in dark clothing")
    .replace(/Batman/giu, "an adult male customer in dark clothing")
    .replace(/आयरन[- ]?मैन/giu, "an adult male customer in red-and-gold geometric clothing")
    .replace(/Iron[- ]?Man/giu, "an adult male customer in red-and-gold geometric clothing")
    // Last-resort image-prompt cleanup: no standalone spider token may remain.
    .replace(/\bspider\b/giu, "geometric")
    .replace(/स्पाइडर/giu, "ज्यामितीय")
    .replace(/superhero/giu, "customer")
    .replace(/सुपरहीरो/giu, "ग्राहक")
    .replace(/\bhero\b/giu, "customer")
    .replace(/masked/giu, "adult male")
    .replace(/mask/giu, "face covering")
    .replace(/मास्क(?:वाला|वाली|वाले)?/giu, "ग्राहक")
    .replace(/\s+/g, " ")
    .trim();
};

const buildSceneKeyframePrompt = (
  basePrompt: string,
  scenePlan: VideoScenePlan | undefined,
  characters: VideoCharacterInput[],
  clipIndex: number,
  hasPreviousFrame: boolean,
): string => {
  const rawSceneDescription =
    scenePlan
      ? buildScenePromptFromPlan(scenePlan)
      : basePrompt.trim();

  const hasCharacterReference =
    characters.some(
      (character) =>
        typeof character.imageUrl === "string" &&
        character.imageUrl.trim().length > 0,
    );

  /*
   * For T2V characters without a saved reference image, keep the keyframe
   * prompt original and scene-based without asking the image provider to
   * reproduce a named franchise character. The resulting frame is used only
   * as Wan I2V's starting scene image; the story/video prompt remains separate.
   */
  const sceneDescription = sanitizeT2VImageGenerationText(
    rawSceneDescription,
    characters,
  );

  const characterInstructions =
    characters.length > 0
      ? characters
          .map((character) => {
            const hasReference =
              typeof character.imageUrl === "string" &&
              character.imageUrl.trim().length > 0;

            return hasReference
              ? [
                  `Visible character: ${character.name} (${character.role}).`,
                  "Use the supplied character reference image only as the visual identity source.",
                  "Keep the same face, hair, clothing, colors, proportions, age, and species as the supplied reference.",
                  "Place this character naturally inside the requested story scene.",
                ].join(" ")
              : [
                  `Visible character: ${character.name} (${character.role}).`,
                  "This character has no separate reference image in this T2V job.",
                  character.visualDescription?.trim()
                    ? `Stable visual identity: ${character.visualDescription.trim()}.`
                    : "",
                  character.imagePrompt?.trim()
                    ? `Additional visual identity guidance: ${character.imagePrompt.trim()}.`
                    : "",
                  "Create one consistent original fictional subject matching the supplied visual identity and the exact scene state; do not introduce alternate clothing, age, body type, face, or species.",
                ]
                  .filter(Boolean)
                  .join(" ");
          })
          .join(" ")
      : "";

  const previousFrameInstruction =
    hasPreviousFrame
      ? "A previous scene frame is also supplied. Preserve its environment, camera language, lighting, spatial relationships, and character continuity while making only the story-required changes. Do not copy it as a pasted image or card."
      : "";

  const openingKeyframeInstruction =
    clipIndex === 0
      ? "OPENING KEYFRAME OVERRIDE: The generated image MUST show the exact beginning of this story before any action has happened. The customer MUST be physically OUTSIDE the burger shop, standing on the exterior sidewalk or front area immediately outside the visible storefront entrance. The burger shop entrance and exterior facade must be clearly visible in the same composition. Do NOT place the customer inside the shop, behind the counter, at the counter, or already ordering. Do NOT depict the customer entering yet. Do NOT depict the order as already placed. The customer must be wearing a clearly visible full-face red-and-blue geometric mask. This image is the starting snapshot; the subsequent video must perform the entrance motion from this outside position into the shop."
      : "";

  const prompt = [
    "Create ONE fresh authoritative cinematic scene image for this exact 5-second beat. This image is the sole visual starting state that will be sent to the image-to-video provider.",
    "This must be a normal full-scene image, not a character sheet, collage, reference board, split screen, panel layout, contact sheet, or presentation slide.",
    `Scene requirements: ${sceneDescription}`,
    openingKeyframeInstruction,
    buildSceneStateKeyframePlan(scenePlan, characters),
    characterInstructions,
    previousFrameInstruction,
    hasPreviousFrame
      ? "The previous frame is continuity context only. Do not use it as the primary starting composition and do not carry forward completed actions that conflict with this beat's start state."
      : "No previous frame is available; rely entirely on the current beat's scene-state plan.",
    clipIndex === 0
      ? "This is the opening scene. Establish the requested starting physical state clearly and naturally before motion begins."
      : "This is a continuation scene. Preserve continuity with the supplied previous frame while establishing the new scene state.",
    "Compose the visible story subjects together in the same believable environment with natural scale, perspective, lighting, and spatial relationships.",
    "Do not add extra people, duplicate characters, unrelated animals, unrelated vehicles, text, logos, panels, labels, borders, or UI elements.",
  ]
    .filter(Boolean)
    .join(" ")
    .trim();

  // Final hard safety pass for T2V image generation.
  return sanitizeT2VImageGenerationText(
    prompt,
    characters,
  );
};

const createSceneKeyframe = async (
  characters: VideoCharacterInput[],
  basePrompt: string,
  scenePlan: VideoScenePlan | undefined,
  clipIndex: number,
  aspectRatio: string,
  continuationReferenceImageUrl?: string,
): Promise<string | undefined> => {
  /*
   * IMPORTANT FOR T2V:
   * A Wan I2V clip MUST receive a referenceImageUrl. Therefore the first
   * T2V clip cannot skip keyframe generation just because no saved/AI
   * character reference image exists.
   *
   * We therefore generate a full scene keyframe even when references.length
   * is zero. The keyframe is the visual starting point for Wan I2V; it is not
   * a separate character-library image.
   */
  const usableCharacters = characters.filter(
    (character) =>
      typeof character.imageUrl === "string" &&
      character.imageUrl.trim().length > 0,
  );

  const references = usableCharacters
    .slice(0, 4)
    .map((character) => ({
      imageUrl: character.imageUrl!.trim(),
    }));


  // IMPORTANT: all visible T2V characters must remain in the prompt even
  // when they do not have separate reference images. `usableCharacters` is
  // only for actual image references; it must never become the character
  // list for scene composition.
  const prompt = buildSceneKeyframePrompt(
    basePrompt,
    scenePlan,
    characters,
    clipIndex,
    false,
  );

  console.log(
    `[VideoService] Generating scene keyframe for clip ${clipIndex + 1}.`,
  );
  console.log(
    `[VideoService] Scene keyframe reference count: ${references.length}`,
  );
  console.log(
    "[VideoService] Scene keyframe references:",
    references.map(
      (reference) =>
        reference.imageUrl,
    ),
  );
  console.log(
    "[VideoService] Scene keyframe visible characters:",
    characters.map((character) => ({
      id: character.id,
      name: character.name,
      role: character.role,
      hasReferenceImage: Boolean(character.imageUrl?.trim()),
    })),
  );

  console.log(
    "[VideoService] Scene keyframe state plan:",
    buildSceneStateKeyframePlan(scenePlan, characters),
  );

  console.log(
    "[VideoService] Scene keyframe prompt:",
    prompt,
  );

  try {
    const result = await sceneImageProvider.generateImages({
      prompt,
      referenceImages:
        references.length > 0
          ? references
          : undefined,
      aspectRatio,
      imageSize: "1K",
      isSceneKeyframe: true,
    });

    const imageUrl =
      result.images?.[0]?.trim();

    if (!imageUrl) {
      throw new Error(
        "Scene keyframe generation returned no image.",
      );
    }

    console.log(
      `[VideoService] Scene keyframe created for clip ${clipIndex + 1}:`,
      imageUrl,
    );

    return imageUrl;
  } catch (error) {
    console.error(
      `[VideoService] Scene keyframe generation failed for clip ${clipIndex + 1}.`,
      error,
    );

    throw new Error(
      `SCENE_KEYFRAME_ERROR: ${
        error instanceof Error
          ? error.message
          : String(error)
      }`,
    );
  }
};

const buildScenePromptFromPlan = (
  plan: VideoScenePlan,
): string => {
  const startText =
    plan.startState.trim()
      ? `Start state: ${plan.startState.trim()}.`
      : "";

  const endText =
    plan.endState.trim()
      ? `End state: ${plan.endState.trim()}.`
      : "";

  const actionText =
    plan.actions.length > 0
      ? `Actions: ${plan.actions.join("; ")}.`
      : "";

  const locationText =
    plan.location?.trim()
      ? `Location: ${plan.location.trim()}.`
      : "";

  const visibleCharactersText =
    plan.visibleCharacterIds.length > 0
      ? `Visible character IDs: ${plan.visibleCharacterIds.join(", ")}.`
      : "";

  return [
    plan.title.trim()
      ? `Scene: ${plan.title.trim()}.`
      : "",
    plan.description.trim(),
    locationText,
    visibleCharactersText,
    startText,
    actionText,
    endText,
  ]
    .filter(Boolean)
    .join(" ");
};

/**
 * Builds the canonical visual state that the scene-keyframe generator must
 * establish before any motion is generated. This is intentionally derived
 * from the structured scene plan rather than from a flattened prompt so
 * character state, emotion, expression, and body language cannot be lost.
 */
const buildSceneStateKeyframePlan = (
  scenePlan: VideoScenePlan | undefined,
  characters: VideoCharacterInput[],
): string => {
  if (!scenePlan) {
    return "";
  }

  const characterById = new Map(
    characters.map((character) => [character.id, character]),
  );

  const visibleCharacterIds = Array.from(
    new Set(scenePlan.visibleCharacterIds ?? []),
  );

  const characterStates = visibleCharacterIds
    .map((characterId) => {
      const character = characterById.get(characterId);
      const plan = scenePlan.characterPlans?.find(
        (item) => item.characterId === characterId,
      );

      if (!plan) {
        return [
          `Character ${character?.name ?? characterId}:`,
          `Start state: ${scenePlan.startState.trim()}.`,
        ].join(" ");
      }

      return [
        `Character ${character?.name ?? characterId}:`,
        plan.startState.trim()
          ? `Start state: ${plan.startState.trim()}.`
          : "",
        plan.emotion.trim()
          ? `Emotion: ${plan.emotion.trim()}.`
          : "",
        plan.expression.trim()
          ? `Expression: ${plan.expression.trim()}.`
          : "",
        plan.bodyLanguage.length > 0
          ? `Body language: ${plan.bodyLanguage.join("; " )}.`
          : "",
      ]
        .filter(Boolean)
        .join(" ");
    })
    .filter(Boolean);

  return [
    "AUTHORITATIVE SCENE-STATE KEYFRAME PLAN:",
    scenePlan.location?.trim()
      ? `Environment: ${scenePlan.location.trim()}.`
      : "",
    scenePlan.startState.trim()
      ? `Overall scene start state: ${scenePlan.startState.trim()}.`
      : "",
    scenePlan.actions.length > 0
      ? `Scene action context: ${scenePlan.actions.join("; " )}.`
      : "",
    characterStates.length > 0
      ? characterStates.join("\n")
      : "",
    scenePlan.endState.trim()
      ? `The frame should be arranged so the requested motion can progress toward this end state: ${scenePlan.endState.trim()}. Do not depict the end state as already completed unless it is also the required start state.`
      : "",
    "The keyframe is a visual snapshot of the scene at the beginning of this beat. Establish the requested starting pose, object ownership, character positions, facial expressions, and body language clearly and simultaneously. Do not invent a different action or move a character into a later state.",
  ]
    .filter(Boolean)
    .join("\n");
};

const buildCharacterIntelligenceControl = (
  scenePlan: VideoScenePlan | undefined,
): string => {
  const characterPlans =
    scenePlan?.characterPlans ?? [];

  if (characterPlans.length === 0) {
    return "";
  }

  const lines = characterPlans.map(
    (plan) => {
      const actions =
        plan.actions.length > 0
          ? `Actions for character ${plan.characterId} in exact order: ${plan.actions.join("; ")}.`
          : "";

      const emotion = plan.emotion.trim()
        ? `Emotion: ${plan.emotion.trim()}.`
        : "";

      const expression = plan.expression.trim()
        ? `Facial expression: ${plan.expression.trim()}.`
        : "";

      const bodyLanguage =
        plan.bodyLanguage.length > 0
          ? `Body language: ${plan.bodyLanguage.join("; ")}.`
          : "";

      const startState = plan.startState.trim()
        ? `Character start state: ${plan.startState.trim()}.`
        : "";

      const endState = plan.endState.trim()
        ? `Character end state: ${plan.endState.trim()}.`
        : "";

      return [
        `Character ID: ${plan.characterId}.`,
        actions,
        emotion,
        expression,
        bodyLanguage,
        startState,
        endState,
      ]
        .filter(Boolean)
        .join(" ");
    },
  );

  return [
    "Character behavior requirements:",
    "Each visible character must perform only the specified actions, with the specified emotion, facial expression, body language, and physical state transition. Do not transfer one character's action or emotion to another character.",
    ...lines,
  ].join("\n");
};

const buildActionControl = (
  scenePlan: VideoScenePlan | undefined,
  clipIndex: number,
  isFinalClip: boolean,
  hasAuthoritativeSceneKeyframe = false,
): string => {
  const actions =
    scenePlan?.actions ?? [];

  const orderedActions =
    actions.length > 0
      ? `Mandatory on-screen actions in this exact chronological order: ${actions.join("; ")}. Do not skip, reorder, replace, or invent actions.`
      : "";

  const startState =
    scenePlan?.startState?.trim()
      ? `Begin from this visible physical state: ${scenePlan.startState.trim()}.`
      : "";

  const endState =
    scenePlan?.    scenePlan?.)
    scenePlan?.    sclip e    scenePlan?.    sclip e    scenePlan?te    scenePlan?. dSt    scenePlan?.    sclip e    scenePlan?.  ty =    scenePlan?.    sclip e    scenePlan?.    sclip e    sce      ? "Start from the supplied scene-keyframe image as the authoritative visual starting state for this clip. Continue the story from that scene-keyframe state; do not restart from, restore, or override it with the previous clip's    scenePlan?Preserve continuity where it does not conflict w    scenePlan?.    scl."
        : "Continue directly from the previous clip's f        : "Contierve the same environment, character identity, camera direction, and physical state."
      : "This is the opening clip. First show the exact requested start state clearly for a brief moment; do not skip the stated starting pose or begin after the action has already started. Then begin the requested action within the first second. Do not present any reference image as a visi      : "Tg c      : "This is pecificChoreography =
    clipIndex === 1
      ? [
          "CLIP 2 PHYSICAL CHOREOGRAPHY:",
          "The shopkeeper must visibly hold or present a small serving of fries with both open hands toward the customer.",
          "The shopkeeper must lean slightly toward the customer while making the fries offer and give one clearly visible nod.",

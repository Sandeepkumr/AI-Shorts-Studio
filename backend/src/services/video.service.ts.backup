const buildContinuityIntelligenceControl = (
  scenePlan: VideoScenePlan | undefined,
  clipIndex: number,
  hasContinuationReference: boolean,
  hasAuthoritativeSceneKeyframe = false,
): string => {
  if (!scenePlan || clipIndex === 0) {
    return hasContinuationReference
      ? [
          "A continuation reference frame is supplied.",
          "Use it only as the previous visual state; do not display it as an image card.",
        ].join(" ")
      : "";
  }

  const continuity = scenePlan.continuity;

  const inheritedStates =
    continuity?.inheritedCharacterStates ?? {};

  const inheritedStateLines =
    Object.entries(inheritedStates)
      .filter(
        ([, state]) =>
          typeof state === "string" &&
          state.trim().length > 0,
      )
      .map(
        ([characterId, state]) =>
          `Character ${characterId} must carry forward this inherited state: ${state.trim()}.`,
      );

  const requiredContinuity =
    continuity?.requiredContinuity ?? [];

  const continuityLines =
    requiredContinuity
      .filter(
        (rule) =>
          typeof rule === "string" &&
          rule.trim().length > 0,
      )
      .map(
        (rule) =>
          `Required continuity: ${rule.trim()}.`,
      );

  const locationInstruction =
    continuity?.locationContinues
      ? scenePlan.location?.trim()
        ? `Keep the same location and environment: ${scenePlan.location.trim()}.`
        : "Keep the same location and environment unless the story explicitly changes it."
      : "Only change the location if the story beat explicitly requires a location change.";

  const startState =
    scenePlan.startState.trim()
      ? `The clip must begin from this visible state: ${scenePlan.startState.trim()}.`
      : "";

  const endState =
    scenePlan.endState.trim()
      ? `The clip must finish at this visible state: ${scenePlan.endState.trim()}.`
      : "";

  const frameInstruction =
    hasAuthoritativeSceneKeyframe
      ? "The supplied scene-keyframe reference is authoritative for the starting visual state of this clip. Treat the previous clip frame only as background continuity context. Do not restore old object positions, completed actions, poses, or handoffs from the previous frame when they conflict with this scene's startState or actions."
      : hasContinuationReference
        ? "The supplied previous-frame reference is authoritative for visual continuity at the start of this clip. Preserve character identity, relative positions, environment, lighting, and physical state from that frame unless the story explicitly changes them."
        : "No previous-frame reference is available. Use the manifest continuity state and next start state as the continuity source of truth.";

  return [
    "Continuity requirements:",
    frameInstruction,
    "Do not restart the scene, reset character positions, or introduce a visually inconsistent new version of the characters.",
    locationInstruction,
    startState,
    ...inheritedStateLines,
    ...continuityLines,
    endState,
  ]
    .filter(Boolean)
    .join("\n");
};



const buildVisionRetryInstruction = (
  visionResult: import("./videoVisionQa.service.js").VideoVisionQaResult,
  attempt: number,
): string => {
  if (attempt <= 1) {
    return "";
  }

  const failedChecks = Object.entries(
    visionResult.checks,
  )
    .filter(([, check]) => !check.pass)
    .map(([name, check]) =>
      `${name}: ${check.reason}`,
    );

  const missingElements =
    visionResult.missingStoryElements
      .filter(Boolean);

  const unexpectedElements =
    visionResult.unexpectedElements
      .filter(Boolean);

  const correctionLines = [
    ...failedChecks,
    ...missingElements.map(
      (item) => `Missing required element: ${item}`,
    ),
    ...unexpectedElements.map(
      (item) => `Remove unexpected element: ${item}`,
    ),
  ];

  if (correctionLines.length === 0) {
    return [
      `This is corrective regeneration attempt ${attempt}.`,
      "The previous generation did not satisfy quality validation.",
      "Make a materially different generation while preserving the requested story, characters, and continuity.",
      "Do not repeat the same failed visual result.",
    ].join(" ");
  }

  return [
    `This is corrective regeneration attempt ${attempt}.`,
    "The previous generated clip failed visual quality validation.",
    "Correct the following issues specifically:",
    ...correctionLines.map(
      (line) => `- ${line}`,
    ),
    "Keep all already-correct story requirements unchanged.",
    "Do not replace characters, alter their identity, or invent new story events while correcting the failed elements.",
    "Produce a materially different result that addresses the failed checks.",
  ].join("\n");
};

const buildClipPrompt = (
  options: VideoGenerationOptions,
  basePrompt: string,
  clipIndex: number,
  previousSceneCharacters: VideoCharacterInput[] = [],
  isFinalClip = false,
  scenePlan?: VideoScenePlan,
  hasContinuationReference = false,
  retryInstruction = "",
  hasAuthoritativeSceneKeyframe = false,
): string => {
  const styleText =
    buildStyleText(
      options.style,
    );

  const cameraText =
    buildCameraText(
      options.camera,
    );

  const visibleCharacters =
    getCharactersForScene(
      (
        options.characters ??
          []
      ) as VideoCharacterInput[],
      basePrompt,
      previousSceneCharacters,
      scenePlan,
    );

  const identityLines =
    visibleCharacters.map(
      (character) => {
        const isSaved =
          "source" in character &&
          character.source === "saved";

        /*
         * Saved characters are image-first. Do not append imagePrompt or
         * another textual appearance description that may conflict with the
         * actual selected character image.
         */
        const preciseIdentity = isSaved
          ? ""
          : (
              "imagePrompt" in character &&
              typeof character.imagePrompt === "string" &&
              character.imagePrompt.trim()
            )
              ? character.imagePrompt.trim()
              : character.visualDescription.trim();

        return [
          `${character.name}: preserve the supplied reference exactly.`,
          isSaved
            ? "This is a saved character; the supplied saved reference image is the sole visual identity source. Ignore any alternate textual appearance description."
            : "",
          preciseIdentity
            ? `Reference appearance guidance: ${preciseIdentity}.`
            : "",
        ]
          .filter(Boolean)
          .join(" ");
      },
    );


  const sceneText =
    scenePlan
      ? [
          scenePlan.title.trim()
            ? `Scene: ${scenePlan.title.trim()}.`
            : "",
          scenePlan.description.trim(),
        ]
          .filter(Boolean)
          .join(" ")
      : basePrompt.trim();

  const continuity =
    clipIndex > 0
      ? hasAuthoritativeSceneKeyframe
        ? "Start from the supplied scene-keyframe reference as the authoritative visual start for this clip. Do not restart from or visually revert to the previous clip's final frame."
        : "Direct continuation of the previous clip. Start from its final frame without restarting the story."
      : "Opening clip. Begin from the exact requested start state, then transition into the requested action naturally within the first second.";

  const actionControl =
    buildActionControl(
      scenePlan,
      clipIndex,
      isFinalClip,
      hasAuthoritativeSceneKeyframe,
    );

  const characterIntelligenceControl =
    buildCharacterIntelligenceControl(
      scenePlan,
    );

  const continuityIntelligenceControl =
    buildContinuityIntelligenceControl(
      scenePlan,
      clipIndex,
      hasContinuationReference,
      hasAuthoritativeSceneKeyframe,
    );

  const startAuthorityInstruction =
    hasAuthoritativeSceneKeyframe
      ? "The supplied scene-keyframe reference is authoritative for the starting visual state of this clip. Treat the previous clip frame only as background continuity context; do not restore or override the scene-keyframe state with it."
      : hasContinuationReference
        ? "The supplied previous-frame reference is the authoritative visual starting state for this clip. Continue directly from that frame."
        : "No image start reference is available; follow the manifest start state exactly.";

  const prompt = [
    sceneText,
    startAuthorityInstruction,
    `Style: ${styleText}.`,
    `Camera: ${cameraText}.`,
    identityLines.length > 0
      ? `Only these visible story characters: ${identityLines.join(" ")}`
      : "",
    continuity,
    actionControl,
    characterIntelligenceControl,
    continuityIntelligenceControl,
    retryInstruction,
    "Do not add extra people, duplicate characters, unrelated animals, unrelated vehicles, text, or logos.",
    "Preserve character identity, clothing, colors, species, facial features, proportions, environment, lighting, and spatial relationships.",
  ]
    .filter(Boolean)
    .join("\n\n");

  return prompt.length <= 2000
    ? prompt
    : `${prompt.slice(0, 1990).trimEnd()}...`;
};


type CharacterSource =
  | "saved"
  | "ai";

type VideoCharacterInput = {
  id: string;
  name: string;
  role: string;
  visualDescription: string;
  imagePrompt?: string;
  imageUrl?: string;
  imageKey?: string;
  source?: CharacterSource;
  savedCharacterId?: string;
};

const resolveCharacterReferences = async (
  characters: VideoCharacterInput[],
): Promise<VideoCharacterInput[]> => {
  if (characters.length === 0) {
    return [];
  }

  const resolved: VideoCharacterInput[] = [];

  for (const character of characters) {
    const source =
      character.source ??
      (character.imageUrl
        ? "saved"
        : "ai");

    /*
     * Saved characters remain image-first and are reused exactly as selected.
     */
    if (source === "saved") {
      if (!character.imageUrl?.trim()) {
        throw new Error(
          `Saved character "${character.name}" is missing its image reference.`,
        );
      }

      console.log(
        `[VideoService] Reusing saved character: ${character.name}`,
      );

      resolved.push({
        ...character,
        imagePrompt: undefined,
        source: "saved",
      });

      continue;
    }

    /*
     * T2V AI characters do NOT get a separate character-library image at this
     * stage. A separate image request can be rejected by the image provider's
     * safety system and is unnecessary because Wan I2V needs a scene frame,
     * not a character-sheet image.
     *
     * The scene keyframe is generated later, from the actual scene plan.
     */
    console.log(
      `[VideoService] T2V AI character reference generation skipped: ${character.name}`,
    );

    resolved.push({
      ...character,
      imageUrl: undefined,
      source: "ai",
      savedCharacterId: undefined,
    });
  }

  return resolved;
};

const emitProgress = (
  callback:
    | VideoProgressCallback
    | undefined,
  progress:
    VideoGenerationProgress,
) => {
  try {
    callback?.(
      progress,
    );
  } catch (error) {
    console.warn(
      "[VideoService] Progress callback failed:",
      error,
    );
  }
};


const runVideoGenerationPreflight = (
  options: VideoGenerationOptions,
  clipScenePlans: Array<VideoScenePlan | undefined>,
  clipCount: number,
  aspectRatio: string,
): void => {
  console.log("[VideoService] ==================================================");
  console.log("[VideoService] PRE-FLIGHT ONLY MODE ENABLED");
  console.log("[VideoService] No image-generation or video-generation provider will be called.");
  console.log("[VideoService] ==================================================");

  let previousSceneCharacters: VideoCharacterInput[] = [];
  let previousFrameAvailable = false;

  for (let index = 0; index < clipCount; index += 1) {
    const scenePlan = clipScenePlans[index];
    const basePrompt = scenePlan
      ? buildScenePromptFromPlan(scenePlan)
      : (options.scenePrompts?.[index] || options.prompt || "Create a cinematic short video scene.");

    const sceneCharacters = getCharactersForScene(
      (options.characters ?? []) as VideoCharacterInput[],
      basePrompt,
      previousSceneCharacters,
      scenePlan,
    );

    // Every T2V beat must have a fresh authoritative scene keyframe.
    const needsSceneKeyframe = true;

    const hasAuthoritativeSceneKeyframe = needsSceneKeyframe;
    const referenceSource = hasAuthoritativeSceneKeyframe
      ? "scene-keyframe"
      : previousFrameAvailable
        ? "previous-frame"
        : sceneCharacters[0]?.imageUrl?.trim()
          ? "character-reference"
          : "MISSING";

    const prompt = buildClipPrompt(
      options,
      basePrompt,
      index,
      previousSceneCharacters,
      index === clipCount - 1,
      scenePlan,
      previousFrameAvailable,
      "",
      hasAuthoritativeSceneKeyframe,
    );

    const keyframePrompt = buildSceneKeyframePrompt(
      basePrompt,
      scenePlan,
      sceneCharacters,
      index,
      previousFrameAvailable,
    );

    console.log(`[VideoService][Preflight] Clip ${index + 1}/${clipCount}`);
    console.log(`[VideoService][Preflight] start authority: ${
      hasAuthoritativeSceneKeyframe
        ? "scene-keyframe (authoritative)"
        : previousFrameAvailable
          ? "previous-frame (authoritative)"
          : "manifest/character reference"
    }`);
    console.log(`[VideoService][Preflight] reference source: ${referenceSource}`);
    console.log(`[VideoService][Preflight] previous frame role: ${
      previousFrameAvailable
        ? "continuity context only"
        : "none"
    }`);
    console.log(`[VideoService][Preflight] visible characters: ${
      sceneCharacters.map((character) => character.name).join(", ") || "none"
    }`);
    console.log(`[VideoService][Preflight] scene plan:`, {
      title: scenePlan?.title,
      startState: scenePlan?.startState,
      actions: scenePlan?.actions,
      endState: scenePlan?.endState,
    });
    console.log(`[VideoService][Preflight] Wan prompt:\n${prompt}`);
    console.log(`[VideoService][Preflight] T2V image keyframe prompt:\n${keyframePrompt}`);

    if (referenceSource === "MISSING") {
      throw new Error(
        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} has no valid reference source.`,
      );
    }

    if (hasAuthoritativeSceneKeyframe && !prompt.includes("scene-keyframe reference is authoritative")) {
      throw new Error(
        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} prompt does not contain the required scene-keyframe authority instruction.`,
      );
    }

    if (
      hasAuthoritativeSceneKeyframe &&
      /Direct continuation of the previous clip\. Start from its final frame/i.test(prompt)
    ) {
      throw new Error(
        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} still contains the old previous-frame authority instruction.`,
      );
    }

    if (
      hasAuthoritativeSceneKeyframe &&
      /previous-frame reference is authoritative for visual continuity at the start/i.test(prompt)
    ) {
      throw new Error(
        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} still treats the previous frame as authoritative.`,
      );
    }

    const unsafeImagePromptTerms = [
      ...sceneCharacters
        .map((character) => character.name.trim())
        .filter(Boolean),
      "spider-man",
      "spiderman",
      "स्पाइडर-मैन",
      "spider-themed",
      "spider theme",
      "spider based",
      "spider inspired",
      "web patterns",
      "स्पाइडर-थीम",
      "स्पाइडर थीम",
      "स्पाइडर-आधारित",
      "स्पाइडर आधारित",
      "स्पाइडर-प्रेरित",
      "स्पाइडर प्रेरित",
      "मकड़ी",
      "superman",
      "सुपरमैन",
      "batman",
      "बैटमैन",
      "iron-man",
      "iron man",
      "आयरन-मैन",
    ];

    const unsafeImagePromptMatches = unsafeImagePromptTerms.filter((term) =>
      new RegExp(escapeRegExp(term), "iu").test(keyframePrompt),
    );

    const residualSpiderFamilyMatch = keyframePrompt.match(
      /(?:spider|स्पाइडर|मकड़ी)(?:[- ]?(?:man|मैन|themed|theme|थीम|आधारित|based|inspired|प्रेरित))?/iu,
    );

    if (residualSpiderFamilyMatch) {
      unsafeImagePromptMatches.push(
        residualSpiderFamilyMatch[0],
      );
    }

    if (unsafeImagePromptMatches.length > 0) {
      throw new Error(
        `VIDEO_PREFLIGHT_FAILED: Clip ${index + 1} T2V image keyframe prompt still contains unsafe/branded terms: ${unsafeImagePromptMatches.join(", ")}.`,
      );
    }

    previousSceneCharacters = sceneCharacters;
    previousFrameAvailable = true;
  }

  console.log("[VideoService] PRE-FLIGHT PASSED: all clip reference-authority checks passed.");
  console.log(`[VideoService] PRE-FLIGHT target: ${options.durationSeconds ?? "default"}s; aspect ratio: ${aspectRatio}.`);
  console.log("[VideoService] No paid generation was performed.");
};

export class VideoService {
  constructor(
    private readonly primaryProvider: VideoProvider =
      new GeminiVideoProvider(),

    private readonly fallbackProvider: VideoProvider =
      new WanVideoProvider(),
  ) {}

  async generateVideo(
    options?: VideoGenerationOptions,
    onProgress?: VideoProgressCallback,
  ): Promise<VideoGenerationResult> {
    const safeOptions =
      options ?? {};

    const targetDuration =
      getTargetDuration(
        safeOptions.durationSeconds,
      );

    const clipCount =
      targetDuration /
      CLIP_DURATION_SECONDS;

    const aspectRatio =
      safeOptions.aspectRatio ||
      "9:16";

    console.log(
      "[VideoService] Target duration:",
      targetDuration,
    );

    console.log(
      "[VideoService] Required clips:",
      clipCount,
    );

    console.log(
      "[VideoService] Aspect ratio:",
      aspectRatio,
    );

    emitProgress(
      onProgress,
      {
        status: "processing",
        stage: "preparing",
        progress: 3,
        currentClip: 0,
        totalClips: clipCount,
      },
    );

    const scenePlans =
      Array.isArray(
        safeOptions.scenePlans,
      )
        ? safeOptions.scenePlans
        : [];

    const scenePrompts =
      safeOptions.scenePrompts ??
      [];

    const incomingCharacters =
      (
        (safeOptions.characters ??
          []) as unknown
      ) as VideoCharacterInput[];

    /*
     * Validate the Story Manifest before any clip planning,
     * character reference generation, or video generation starts.
     * The incoming character IDs are used here because AI-generated
     * character references may receive new saved IDs later.
     */
    if (scenePlans.length > 0) {
      console.log(
        "[VideoService] Validating story manifest before clip planning...",
      );

      assertValidStoryManifest(
        scenePlans,
        incomingCharacters as VideoCharacterInput[],
      );

      console.log(
        "[VideoService] Story manifest validation passed.",
      );
    }

    /*
     * The clip planner converts story beats into the exact number
     * of five-second video clips while preserving chronology.
     */
    const buildClipScenePlans = (
      plans: VideoScenePlan[],
      totalClips: number,
    ): Array<VideoScenePlan | undefined> => {
      if (plans.length === 0) {
        return [];
      }

      if (
        plans.length <= totalClips
      ) {
        const result =
          plans.map(
            (plan) => ({
              ...plan,
              durationSeconds: 5,
            }),
          );

        while (
          result.length <
          totalClips
        ) {
          const previous =
            result[result.length - 1];

          if (!previous) {
            break;
          }

          result.push({
            ...previous,
            sceneNumber:
              previous.sceneNumber +
              1,
            title:
              `${previous.title} — continuation`,
            narration: "",
            actions: [],
            startState:
              previous.endState,
            endState:
              previous.endState,
            durationSeconds: 5,
          });
        }

        return result;
      }

      const baseSize =
        Math.floor(
          plans.length /
            totalClips,
        );

      const remainder =
        plans.length %
        totalClips;

      const groups:
        VideoScenePlan[][] =
        [];

      let cursor = 0;

      for (
        let clipIndex = 0;
        clipIndex < totalClips;
        clipIndex += 1
      ) {
        const extra =
          clipIndex >=
          totalClips - remainder
            ? 1
            : 0;

        const groupSize =
          baseSize + extra;

        groups.push(
          plans.slice(
            cursor,
            cursor + groupSize,
          ),
        );

        cursor += groupSize;
      }

      return groups.map(
        (group, clipIndex) => {
          const first =
            group[0];

          const last =
            group[group.length - 1];

          return {
            sceneNumber:
              first?.sceneNumber ??
              clipIndex + 1,
            title:
              group
                .map(
                  (plan) =>
                    plan.title.trim(),
                )
                .filter(Boolean)
                .join(" → ") ||
              `Story beat ${clipIndex + 1}`,
            description:
              group
                .map(
                  (plan) =>
                    plan.description.trim(),
                )
                .filter(Boolean)
                .join(" "),
            narration:
              group
                .map(
                  (plan) =>
                    plan.narration.trim(),
                )
                .filter(Boolean)
                .join(" "),
            durationSeconds:
              5,
            visibleCharacterIds:
              Array.from(
                new Set(
                  group.flatMap(
                    (plan) =>
                      plan.visibleCharacterIds,
                  ),
                ),
              ),
            actions:
              group.flatMap(
                (plan) =>
                  plan.actions,
              ),
            startState:
              first?.startState ??
              "",
            endState:
              last?.endState ??
              "",
          };
        },
      );
    };

    const clipScenePlans =
      buildClipScenePlans(
        scenePlans,
        clipCount,
      );

    const preflightOnly =
      /^(1|true|yes)$/i.test(
        (process.env.SHIVORA_VIDEO_PREFLIGHT || "").trim(),
      );

    if (preflightOnly) {
      runVideoGenerationPreflight(
        safeOptions,
        clipScenePlans,
        clipCount,
        aspectRatio,
      );

      throw new Error(
        "VIDEO_PREFLIGHT_ONLY: Pre-flight completed successfully. No paid image or video generation was performed.",
      );
    }

    const clipUrls: string[] = [];

    const resolvedCharacters =
      await resolveCharacterReferences(
        incomingCharacters,
      );

    const videoOptions: VideoGenerationOptions = {
      ...safeOptions,
      characters:
        resolvedCharacters as VideoGenerationOptions["characters"],
    };

    console.log(
      "[VideoService] Characters passed to video provider:",
      videoOptions.characters ?? [],
    );

    console.log(
      "[VideoService] Character reference images:",
      (videoOptions.characters ?? [])
        .map(
          (character) =>
            character.imageUrl,
        )
        .filter(Boolean),
    );

    const videoProviderMode =
      (process.env.SHIVORA_VIDEO_PROVIDER || "wan")
        .trim()
        .toLowerCase();

    let useFallback =
      videoProviderMode !== "gemini";

    const maxAttempts = Math.max(
      1,
      Number(
        process.env.SHIVORA_MAX_VIDEO_ATTEMPTS || "1",
      ) || 1,
    );

    /*
     * Overall video progress:
     *
     * 0-10   Preparing
     * 10-75  Generating clips
     * 75-80  Joining clips
     * 80-87  Reserved / transition
     * 87-94  Audio
     * 94-100 Finalizing
     */

    const clipStartProgress = 10;
    const clipEndProgress = 75;

    let continuationReferenceImageUrl:
      string | undefined;

    let previousSceneCharacters:
      VideoCharacterInput[] = [];

    for (
      let index = 0;
      index < clipCount;
      index += 1
    ) {
      const scenePlan =
        clipScenePlans[index];

      const basePrompt =
        scenePlan
          ? buildScenePromptFromPlan(
              scenePlan,
            )
          : (
              scenePrompts[index] ||
              safeOptions.prompt ||
              "Create a cinematic short video scene."
            );

      const sceneCharacters =
        getCharactersForScene(
          resolvedCharacters,
          basePrompt,
          previousSceneCharacters,
          scenePlan,
        );

      /*
       * STEP 5 — EVERY T2V BEAT GETS A FRESH AUTHORITATIVE KEYFRAME.
       *
       * The previous clip frame is continuity context only. It must never
       * become the Wan starting image for the next beat. This guarantees that
       * each 5-second beat starts from the newly planned visual state.
       */
      const needsSceneKeyframe = true;

      let sceneKeyframeReferenceUrl:
        string | undefined;

      if (needsSceneKeyframe) {
        sceneKeyframeReferenceUrl =
          await createSceneKeyframe(
            sceneCharacters,
            basePrompt,
            scenePlan,
            index,
            aspectRatio,
            continuationReferenceImageUrl,
          );
      }

      let clipOptions:
        VideoGenerationOptions;

      let retryInstruction = "";

      clipOptions = {
        ...videoOptions,
        prompt:
          buildClipPrompt(
            videoOptions,
            basePrompt,
            index,
            previousSceneCharacters,
            index === clipCount - 1,
            scenePlan,
            Boolean(
              continuationReferenceImageUrl,
            ),
            retryInstruction,
            Boolean(
              sceneKeyframeReferenceUrl,
            ),
          ),
        durationSeconds:
          CLIP_DURATION_SECONDS,
        aspectRatio,
        sceneNumber:
          index + 1,
        /*
         * The scene keyframe is mandatory and authoritative for every T2V
         * beat. Never fall back to the previous clip frame or a character
         * reference as the Wan starting image.
         */
        referenceImageUrl:
          sceneKeyframeReferenceUrl,
      };

      if (!sceneKeyframeReferenceUrl?.trim()) {
        throw new Error(
          `T2V clip ${index + 1} cannot start: a fresh authoritative scene keyframe was not created.`,
        );
      }

      if (
        clipOptions.referenceImageUrl?.trim() !==
        sceneKeyframeReferenceUrl.trim()
      ) {
        throw new Error(
          `T2V clip ${index + 1} reference mismatch: Wan must receive the fresh scene keyframe, not a fallback reference.`,
        );
      }

      console.log(
        `[VideoService] Clip ${index + 1} final prompt:`,
        clipOptions.prompt,
      );

      console.log(
        `[VideoService] Clip ${index + 1} reference image URLs:`,
        (clipOptions.characters ?? [])
          .map(
            (character) =>
              character.imageUrl,
          )
          .filter(Boolean),
      );

      console.log(
        `[VideoService] Clip ${index + 1} visible characters:`,
        sceneCharacters.map(
          (character) =>
            character.name,
        ),
      );

      console.log(
        `[VideoService] Clip ${index + 1} Wan referenceImageUrl:`,
        clipOptions.referenceImageUrl,
      );

      console.log(
        `[VideoService] Clip ${index + 1} reference source:`,
        sceneKeyframeReferenceUrl
          ? "scene-keyframe"
          : continuationReferenceImageUrl
            ? "previous-frame"
            : "character-reference",
      );

      console.log(
        `[VideoService] Clip ${index + 1} start authority:`,
        "scene-keyframe (authoritative); previous-frame is continuity context only",
      );

      emitProgress(
        onProgress,
        {
          status: "processing",
          stage: "clips",

          progress:
            Math.round(
              clipStartProgress +
                ((clipEndProgress -
                  clipStartProgress) /
                  clipCount) *
                  index,
            ),

          currentClip:
            index + 1,

          totalClips:
            clipCount,
        },
      );

      let generated:
        VideoGenerationResult | undefined;

      let normalized:
        string | undefined;

      let clipAccepted = false;

      for (
        let attempt = 1;
        attempt <= maxAttempts;
        attempt += 1
      ) {
        try {
          retryInstruction =
            attempt > 1
              ? retryInstruction
              : "";

          clipOptions = {
            ...clipOptions,
            prompt:
              buildClipPrompt(
                videoOptions,
                basePrompt,
                index,
                previousSceneCharacters,
                index === clipCount - 1,
                scenePlan,
                Boolean(
                  continuationReferenceImageUrl,
                ),
                retryInstruction,
                Boolean(
                  sceneKeyframeReferenceUrl,
                ),
              ),
          };

          console.log(
            `[VideoService] Generating clip ${index + 1}/${clipCount}, attempt ${attempt}/${maxAttempts}`,
          );

          if (!useFallback) {
            console.log(
              `[VideoService] Using Gemini for clip ${index + 1}.`,
            );

            generated =
              await this.primaryProvider.generateVideo(
                clipOptions,
              );
          } else {
            console.log(
              `[VideoService] Using Wan 2.2 for clip ${index + 1}.`,
            );

            generated =
              await this.fallbackProvider.generateVideo(
                clipOptions,
              );
          }

          normalized =
            await normalizeVideoClip(
              generated.video,
              aspectRatio,
              CLIP_DURATION_SECONDS,
            );

          /*
           * Step 6A structural quality gate.
           */
          await assertVideoDuration(
            normalized,
            CLIP_DURATION_SECONDS,
            `clip ${index + 1}`,
          );

          /*
           * Step 6B vision quality gate.
           * The clip is accepted only when the sampled frames
           * reasonably satisfy the expected Story Manifest plan.
           */
          let visionResult;

          try {
            visionResult =
              await evaluateVideoClipWithVision(
                normalized,
                scenePlan ?? {
                  sceneNumber:
                    index + 1,
                  title:
                    `Clip ${index + 1}`,
                  description:
                    basePrompt,
                  narration: "",
                  durationSeconds:
                    CLIP_DURATION_SECONDS,
                  visibleCharacterIds: [],
                  actions: [],
                  startState: "",
                  endState: "",
                },
                sceneCharacters,
              );
          } catch (visionError) {
            /*
             * Vision QA errors are infrastructure/evaluator errors, not
             * evidence that the generated clip is visually wrong.
             *
             * IMPORTANT:
             * Never regenerate a paid video clip because the QA service
             * itself failed (for example invalid model parameters, API
             * errors, timeouts, malformed QA responses, etc.).
             *
             * The current attempt has already generated and normalized
             * the video successfully, so retrying here would spend money
             * again without fixing the QA infrastructure problem.
             */
            console.error(
              `[VideoService] Vision QA infrastructure error on clip ${index + 1}.`,
              visionError,
            );

            throw new Error(
              `VIDEO_VISION_QA_ERROR: ${
                visionError instanceof Error
                  ? visionError.message
                  : String(visionError)
              }`,
            );
          }

          console.log(
            `[VideoService] Clip ${index + 1} vision QA:`,
            {
              status:
                visionResult.status,
              overallScore:
                visionResult.overallScore,
              retryRecommended:
                visionResult.retryRecommended,
              summary:
                visionResult.summary,
            },
          );

          if (
            visionResult.status ===
            "pass"
          ) {
            clipAccepted = true;
            break;
          }

          if (!visionResult.retryRecommended) {
            console.error(
              `[VideoService] Vision QA rejected clip ${index + 1} without a safe regeneration recommendation. Stopping to avoid unnecessary paid generation.`,
            );

            throw new Error(
              `VIDEO_VISION_QA_NON_RETRYABLE: ${visionResult.summary}`,
            );
          }

          console.warn(
            `[VideoService] Clip ${index + 1} failed vision QA on attempt ${attempt}.`,
          );

          console.warn(
            "[VideoService] Missing story elements:",
            visionResult.missingStoryElements,
          );

          console.warn(
            "[VideoService] Unexpected elements:",
            visionResult.unexpectedElements,
          );

          retryInstruction =
            buildVisionRetryInstruction(
              visionResult,
              attempt + 1,
            );

          if (
            attempt < maxAttempts
          ) {
            console.warn(
              `[VideoService] Regenerating clip ${index + 1} because vision QA explicitly rejected the generated clip.`,
            );
          }
        } catch (error) {
          const errorMessage =
            error instanceof Error
              ? error.message
              : String(error);

          if (
            errorMessage.startsWith(
              "VIDEO_VISION_QA_ERROR:",
            ) ||
            errorMessage.startsWith(
              "VIDEO_VISION_QA_NON_RETRYABLE:",
            )
          ) {
            /*
             * Do not retry a paid generation when the evaluator failed.
             * Propagate immediately to fail the job safely and preserve
             * the generated clip for debugging.
             */
            console.error(
              `[VideoService] Stopping clip ${index + 1} without regeneration because Vision QA failed.`,
            );
            throw error;
          }

          console.warn(
            `[VideoService] Clip ${index + 1} attempt ${attempt} failed:`,
            error,
          );

          if (
            attempt >= maxAttempts
          ) {
            throw error;
          }
        }
      }

      if (
        !clipAccepted ||
        !normalized
      ) {
        throw new Error(
          `Clip ${index + 1} failed quality validation after ${maxAttempts} attempts.`,
        );
      }

      clipUrls.push(
        normalized,
      );

      /*
       * Carry the characters that were actually visible in this
       * scene into the next scene. This preserves indirect references
       * such as "the two riders" even when their names disappear from
       * the next scene prompt.
       */
      previousSceneCharacters =
        sceneCharacters;

      try {
        const normalizedPath =
          resolveLocalUploadPath(
            normalized,
          );

        continuationReferenceImageUrl =
          await extractLastFrameAsReference(
            normalizedPath,
            index + 1,
          );

        console.log(
          `[VideoService] Clip ${index + 1} continuation reference:`,
          continuationReferenceImageUrl,
        );
      } catch (error) {
        console.warn(
          `[VideoService] Could not extract continuation frame from clip ${index + 1}.`,
        );
        console.warn(
          "[VideoService] Continuity fallback:",
          error,
        );
      }

      const clipProgress =
        Math.round(
          clipStartProgress +
            ((clipEndProgress -
              clipStartProgress) /
              clipCount) *
              (index + 1),
        );

      emitProgress(
        onProgress,
        {
          status: "processing",
          stage: "clips",
          progress:
            clipProgress,
          currentClip:
            index + 1,
          totalClips:
            clipCount,
        },
      );

      console.log(
        `[VideoService] Clip ${index + 1}/${clipCount} ready`,
      );
    }

    emitProgress(
      onProgress,
      {
        status: "processing",
        stage: "joining",
        progress: 80,
        currentClip:
          clipCount,
        totalClips:
          clipCount,
      },
    );

    await assertAssemblyContract(
      clipUrls,
      clipCount,
      CLIP_DURATION_SECONDS,
      targetDuration,
    );

    const combinedVideo =
      await concatVideoClips(
        clipUrls,
      );

    console.log(
      "[VideoService] Combined video:",
      combinedVideo,
    );

    const narration =
      safeOptions.narration?.trim();

    const selectedVoice =
      mapVoiceToVoiceServiceVoice(
        safeOptions.voice,
      );

    /*
     * No narration or voice disabled.
     */
    if (
      !narration ||
      !selectedVoice
    ) {
      console.log(
        "[VideoService] Voice disabled or narration unavailable.",
      );

      await assertVideoDuration(
        combinedVideo,
        targetDuration,
        "combined video",
      );

      emitProgress(
        onProgress,
        {
          status: "processing",
          stage: "finalizing",
          progress: 96,
          currentClip:
            clipCount,
          totalClips:
            clipCount,
        },
      );

      return {
        video:
          combinedVideo,

        durationSeconds:
          targetDuration,

        model:
          useFallback
            ? "wan-2.2-14b-image-to-video"
            : "gemini",

        sceneNumber:
          safeOptions.sceneNumber,
      };
    }

    emitProgress(
      onProgress,
      {
        status: "processing",
        stage: "audio",
        progress: 87,
        currentClip:
          clipCount,
        totalClips:
          clipCount,
      },
    );

    const speechScript =
      buildSpeechScript(
        narration,
      );

    console.log(
      "[VideoService] Generating narration audio...",
    );

    console.log(
      "[VideoService] Language:",
      safeOptions.language ??
        "English (US)",
    );

    console.log(
      "[VideoService] Voice:",
      selectedVoice,
    );

    console.log(
      "[VideoService] TTS transcript:",
      speechScript,
    );

    /*
     * IMPORTANT:
     * Pass language to VoiceService.
     *
     * VoiceService performs translation first
     * when a non-English language is selected,
     * then ElevenLabs receives only the final
     * translated transcript.
     */
    const voiceResult =
      await voiceService.generateVoice(
        speechScript,
        selectedVoice,
        safeOptions.language,
      );

    console.log(
      "[VideoService] TTS audio generated:",
      voiceResult.audio,
    );

    emitProgress(
      onProgress,
      {
        status: "processing",
        stage: "finalizing",
        progress: 94,
        currentClip:
          clipCount,
        totalClips:
          clipCount,
      },
    );

    const finalVideo =
      await mergeVideoAndAudio(
        combinedVideo,
        voiceResult.audio,
        targetDuration,
      );

    console.log(
      "[VideoService] Final video with audio:",
      finalVideo,
    );

    await assertVideoDuration(
      finalVideo,
      targetDuration,
      "final video",
    );

    emitProgress(
      onProgress,
      {
        status: "processing",
        stage: "finalizing",
        progress: 99,
        currentClip:
          clipCount,
        totalClips:
          clipCount,
      },
    );

    return {
      video:
        finalVideo,

      durationSeconds:
        targetDuration,

      model:
        useFallback
          ? "wan-2.2-14b-image-to-video"
          : "gemini",

      sceneNumber:
        safeOptions.sceneNumber,
    };
  }
}

export const createVideoService = (
  primaryProvider?: VideoProvider,
  fallbackProvider?: VideoProvider,
) =>
  new VideoService(
    primaryProvider,
    fallbackProvider,
  );

export const videoService =
  createVideoService();